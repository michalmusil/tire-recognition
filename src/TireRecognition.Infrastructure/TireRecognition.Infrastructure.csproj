<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <IsWindows Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</IsWindows>
        <IsLinux Condition="$([MSBuild]::IsOSPlatform('Linux'))">true</IsLinux>
        <IsOSX Condition="$([MSBuild]::IsOSPlatform('OSX'))">true</IsOSX>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\TireRecognition.Application\TireRecognition.Application.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Fastenshtein" Version="1.0.12"/>
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.5" />
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.5" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.5" />
        <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108"/>
        <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.10.0.20241108" Condition="'$(IsLinux)' == 'true'"/>
        <PackageReference Include="OpenCvSharp4.runtime.osx_arm64" Version="4.8.1-rc" Condition="'$(IsOSX)' == 'true'"/>
        <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" Condition="'$(IsWindows)' == 'true'"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.1" Condition="'$(IsLinux)' == 'true'"/>
        <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.1" Condition="'$(IsOSX)' == 'true'"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.1" Condition="'$(IsWindows)' == 'true'"/>
        <PackageReference Include="YoloDotNet" Version="4.1.0"/>
        <PackageReference Include="YoloDotNet.ExecutionProvider.Cpu" Version="1.1.0"/>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Models\" />
    </ItemGroup>

    <ItemGroup>
      <None Update="Models\tire_segmentation_v5.onnx">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
