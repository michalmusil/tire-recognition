<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>8c3b9f85-3aa5-4987-8e87-dba5fe58409d</UserSecretsId>
    </PropertyGroup>

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0"/>
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\TireRecognition.Application\TireRecognition.Application.csproj" />
      <ProjectReference Include="..\TireRecognition.Domain\TireRecognition.Domain.csproj" />
      <ProjectReference Include="..\TireRecognition.Infrastructure\TireRecognition.Infrastructure.csproj" />
    </ItemGroup>

</Project>
