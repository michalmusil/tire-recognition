{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OTEL_ENABLED": false,
  "OTEL_SERVICE_NAME": "TireReconition",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "<YOUR_OTLP_ENDPOINT>",
  "OTEL_EXPORTER_OTLP_HEADERS": "<YOUR_OTLP_AUTH_HEADER>",
  "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
  "OTEL_RESOURCE_ATTRIBUTES": "service.namespace=tire-recognition",
  "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
  "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
  "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
  "AuthOptions": {
    "Enabled": false,
    "SchemeName": "ApiKey",
    "ApiKey": "<API_KEY_OTHER_SERVICES_HAVE_TO_USE_FOR_AUTHENTICATION_WHEN_ENABLED>"
  },
  "ResilienceOptions": {
    "MaxRetries": 2,
    "RetryDelayMs": 1000,
    "AttemptTimeoutSeconds": 10,
    "TotalTimeoutSeconds": 40,
    "CircuitBreakerSamplingDurationSeconds": 60
  },
  "PreprocessingOptions": {
    "MaxInputImageSize": 4000,
    "MaxOutputImageSize": 2048,
    "NumberOfSlices": 2,
    "TireOuterRadiusRatio": 1.3,
    "TireInnerRadiusRatio": 0.9,
    "TireStripProlongWidthRatio": 0.17,
    "SliceOverlapRatio": 0.12,
    "TireRimDetectionConfidenceThreshold": 0.6,
    "TireRimDetectionModelRelativePath": "Models/tire_segmentation_v5.onnx"
  },
  "RecognitionOptions": {
    "VlmEndpoint": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
    "VlmTemperature": 0,
    "VlmSeed": 42,
    "VlmPrompt": "<THE_PROMPT_TO_YOUR_VISION_LANGUAGE_MODEL>",
    "VlmApiKey": "<THE_API_KEY_TO_YOUR_VISION_LANGUAGE_MODEL>",
    "InputTokenPricePerMillion": 0.3,
    "OutputTokenPricePerMillion": 2.5
  },
  "TireDbMatchingOptions": {
    "TireCodeEndpointUri": "URI_TO_TIRE_CODES_ENDPOINT",
    "TireManufacturerEndpointUri": "URI_TO_TIRE_MANUFACTURERS_ENDPOINT",
    "RemoteDbCacheExpirationMinutes": 60,
    "DefaultTireDbMatchingResultLimit": 30
  }
}
